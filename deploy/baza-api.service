# /etc/systemd/system/baza-api.service
[Unit]
Description=Baza API (серверные функции проекта)
After=network.target postgresql.service

[Service]
WorkingDirectory=/opt/baza
EnvironmentFile=/opt/baza/.env
ExecStart=/opt/baza/venv/bin/gunicorn -w 4 --threads 8 -t 620 -b 127.0.0.1:8000 --chdir server app:app
Restart=always
User=www-data

[Install]
WantedBy=multi-user.target
