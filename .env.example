# Пример настроек. Реальные значения хранятся в секретах проекта и в репозиторий не попадают.

# === Свой сервер (VPS) ===
# Адрес сайта, на котором будет работать проект
SITE_URL=https://baza-info.online
# Адрес API для сайта (подставляется при сборке фронтенда)
VITE_API_BASE=https://baza-info.online/api
# Адреса функций для фоновых задач (сканер вызывает сам себя)
TG_LOOKUP_URL=https://baza-info.online/api/tg-lookup
KB_BOT_URL=https://baza-info.online/api/kb-bot
# Сколько секунд даётся одной функции на ответ
FUNCTION_TIMEOUT=60

# База данных
DATABASE_URL=postgresql://baza:ПАРОЛЬ@127.0.0.1:5432/baza
MAIN_DB_SCHEMA=t_p67171637_yug_transfer_prize_l

# Хранилище фото (любое S3-совместимое: Яндекс Облако, Selectel, MinIO на этом же сервере)
S3_ENDPOINT=
S3_BUCKET=files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Публичный адрес, по которому открываются фото (без / в конце)
FILES_PUBLIC_URL=https://baza-info.online/files
# Папка для скачанных фото при переносе
FILES_DIR=/opt/baza/uploads
# Картинки-заглушки для бота (после переноса)
NO_PHOTO_URL=https://baza-info.online/no-photo.jpg
NO_AVATAR_URL=https://baza-info.online/no-avatar.jpg

# Вход в админку
ADMIN_LOGIN=
ADMIN_PASSWORD=
POSTS_LOGIN=
POSTS_PASSWORD=
CRON_SECRET=

# Telegram-боты и каналы
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_2=
KB_BOT_TOKEN=
KB_COMPLAINTS_CHAT_ID=
UG_INFO_BOT_TOKEN=
UG_INFO_BOT_TOKEN_NEW=
DISPATCH_CHAT_ID=

# Посты в канал
TELEGRAM_CHANNEL_ID=
UG_DRIVER_CHANNEL_ID=
POSTS_CHAT_4_ID=
POSTS_CHAT_5_ID=
POSTS_CHAT_6_ID=
POSTS_CHAT_7_ID=
POSTS_CHAT_8_ID=
POSTS_CHAT_9_ID=
POSTS_CHAT_10_ID=
POSTS_CHAT_11_ID=
POSTS_CHAT_HORSE_ID=
POSTS_CHAT_VIP_ID=

# Сканер Telegram (аккаунты)
TG_API_ID=
TG_API_HASH=
TG_PROXY=
TG_PROXY_3=
TG_PROXY_NEW=

# MAX
MAX_BOT_TOKEN=
MAX_BOT_TOKEN_NEW=
MAX_CHAT_ID=

# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_SHOP_ID_NEW=
YOOKASSA_SECRET_KEY_NEW=
